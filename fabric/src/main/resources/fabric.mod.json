{
    "schemaVersion": 1,
    "id": "vs_template",
    "version": "${version}",
    "name": "${mod_name}",
    "description": "${description}",
    "authors": [
        "${mod_author}"
    ],
    "contact": {
        "homepage": "https://fabricmc.net/",
        "sources": "https://github.com/FabricMC/fabric-example-mod"
    },
    "license": "${license}",
    "icon": "icon.png",
    "environment": "*",
    "entrypoints": {
      "main": [
        {
          "adapter": "kotlin",
          "value": "org.valkyrienskies.vs_template.VSTemplateModFabric"
        }
      ]
    },
    "mixins": [
        "${mod_id}.mixins.json",
        "${mod_id}.fabric.mixins.json"
    ],
    "depends": {
        "fabricloader": ">=0.14",
        "fabric": "*",
        "minecraft": "${minecraft_version}",
        "java": ">=17",
        "valkyrienskies": ">=2.4.0"
    },
    "suggests": {
        "another-mod": "*"
    }
}
  